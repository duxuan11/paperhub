# ===================== PaperHub 配置 =====================
# 复制为 .env 后按需修改。所有 Secret 必须通过环境变量，禁止写死在代码中。

# ---- 核心服务 ----
# PostgreSQL 连接串
DATABASE_URL=postgresql+asyncpg://paperhub:paperhub@localhost:5432/paperhub
# Redis 连接串
REDIS_URL=redis://localhost:6379/0

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=paperhub
MINIO_SECRET_KEY=paperhub-secret
MINIO_SECURE=false
MINIO_BUCKET=paperhub

# ---- MinerU API ----
# 留空则使用 MockMinerUService（PyMuPDF 本地解析）
MINERU_API_URL=
MINERU_API_KEY=

# ---- YOLO Figure 检测 ----
# 留空则使用启发式检测（MinerU 提取的图片按规则分类）
# 有训练好的模型时填入路径，例如 ./models/figure.pt
YOLO_MODEL_PATH=
# 是否启用真实 YOLO（true/false）
YOLO_ENABLED=false

# ---- LLM（OpenAI-compatible）----
# 默认 DeepSeek。留空 API Key 时使用 MockLLMService
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT=120

# ---- Open WebUI（单 Agent 入口，可选）----
# 配齐 OPEN_WEBUI_URL + OPEN_WEBUI_API_KEY 后，页面内 Chat 作为 Open WebUI 的瘦客户端，
# 由 Open WebUI 统一持有 Memory / Tools / MCP / 对话历史 / Prompt（不再维护第二套 Agent）。
# OPEN_WEBUI_API_KEY 在 Open WebUI「设置 → 账号 → API 密钥」中生成。
# OPEN_WEBUI_MODEL 形如 openwebui/<模型>:<管道>，例如 openwebui/deepseek-chat:default；留空回退 OPENAI_MODEL。
# 未配置时页面 Chat 降级为直连 OpenAI-compatible API / Mock。
OPEN_WEBUI_URL=
OPEN_WEBUI_API_KEY=
OPEN_WEBUI_MODEL=

# ---- 微信公众号 ----
# 留空则使用 MockWeChatPublisher
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---- PaperHub 自身 API 鉴权 ----
# 留空 = 开发模式不鉴权；设置后 CLI 需 paperhub config set api-key xxx
PAPERHUB_API_KEY=

# ---- 应用 ----
APP_HOST=0.0.0.0
APP_PORT=8000
# CORS 允许来源
CORS_ORIGINS=http://localhost:3000,http://localhost
