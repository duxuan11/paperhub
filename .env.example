# ===================== PaperHub 配置模板 =====================
# 复制为 .env 后按需修改。所有 Secret 必须通过环境变量，禁止写死在代码中。
# 说明：留空的服务会自动降级为 Mock（不调用外部 API），便于本地跑通流程。

# ---- 核心服务 ----
# PostgreSQL 连接串（Docker Compose 内会被覆盖为 postgres:5432）
DATABASE_URL=postgresql+asyncpg://paperhub:paperhub@localhost:5432/paperhub
# Redis 连接串（Arq 任务队列）
REDIS_URL=redis://localhost:6379/0

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=paperhub
MINIO_SECRET_KEY=paperhub-secret
MINIO_SECURE=false
MINIO_BUCKET=paperhub

# ---- MinerU API ----
# 留空则使用 MockMinerUService（PyMuPDF 本地解析）
MINERU_API_URL=https://mineru.net/api/v4/extract/task
MINERU_API_KEY=
# pipeline / vlm / MinerU-HTML
MINERU_MODEL_VERSION=pipeline

# ---- YOLO Figure 检测 ----
# 留空 YOLO_MODEL_PATH 则仅使用启发式回退；需 `uv sync --extra yolo` 安装 onnxruntime
YOLO_MODEL_PATH=
YOLO_ENABLED=false

# ---- LLM（OpenAI-compatible）----
# 留空 OPENAI_API_KEY 时使用 MockLLMService
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT=120

# ---- 微信公众号 ----
# 留空 WECHAT_APP_ID / WECHAT_APP_SECRET 则使用 MockWeChatPublisher（不会真的发送）。
#
# 真实发送前必须在公众号后台完成两件事，否则接口会失败：
#   1. IP 白名单：设置与开发 → 基本配置 → IP白名单，加入本机公网出口 IP
#      （未加白名单时微信返回 errcode=40164 invalid ip ... not in whitelist）
#   2. 开通草稿箱/发布功能，且账号具备对应接口权限（否则 errcode=48001 / 53503 / 53504）
#
# WECHAT_THUMB_MEDIA_ID：草稿封面用的「永久素材」media_id（图文草稿必填）。
#   留空时 PaperHub 会自动把文章首图（无配图则用内置渐变封面）上传为永久素材并缓存复用。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_THUMB_MEDIA_ID=

# ---- PaperHub 自身 API 鉴权 ----
# 留空 = 开发模式不鉴权；设置后 CLI 需 paperhub config set api-key xxx
PAPERHUB_API_KEY=

# ---- 应用 ----
APP_HOST=0.0.0.0
APP_PORT=8000
# CORS 允许来源
CORS_ORIGINS=http://localhost:3000,http://localhost
