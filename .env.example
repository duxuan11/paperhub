# ===================== PaperHub 配置 =====================
# 复制为 .env 后按需修改。所有 Secret 必须通过环境变量，禁止写死在代码中。

# ---- 核心服务 ----
# PostgreSQL 连接串
DATABASE_URL=postgresql+asyncpg://paperhub:paperhub@localhost:5432/paperhub
# Redis 连接串
REDIS_URL=redis://localhost:6379/0

# ---- MinIO 对象存储 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=paperhub
MINIO_SECRET_KEY=paperhub-secret
MINIO_SECURE=false
MINIO_BUCKET=paperhub

# ---- MinerU API ----
# 留空则使用 MockMinerUService（PyMuPDF 本地解析）
# API 根地址（mineru.net v4），例如 https://mineru.net/api/v4
MINERU_API_URL=
MINERU_API_KEY=
# pipeline / vlm / MinerU-HTML
MINERU_MODEL_VERSION=pipeline

# ---- YOLO Figure 检测 ----
# 说明：检测输入为「整页 PDF 渲染图」，YOLO 在整页上框出 Figure 并裁剪保存；
#       启用但未检出（如未训练/低置信度）时自动回退为按 markdown 顺序的内嵌图片。
# 留空 YOLO_MODEL_PATH 则仅使用启发式回退。
# 需要训练好的检测权重，例如 ./models/figure.pt；需 `uv sync --extra yolo` 安装依赖
YOLO_MODEL_PATH=
# 是否启用真实 YOLO（true/false）
YOLO_ENABLED=false

# ---- LLM（OpenAI-compatible）----
# 默认 DeepSeek。留空 API Key 时使用 MockLLMService
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT=120

# ---- 微信公众号 ----
# 留空则使用 MockWeChatPublisher
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---- PaperHub 自身 API 鉴权 ----
# 留空 = 开发模式不鉴权；设置后 CLI 需 paperhub config set api-key xxx
PAPERHUB_API_KEY=

# ---- 应用 ----
APP_HOST=0.0.0.0
APP_PORT=8000
# CORS 允许来源
CORS_ORIGINS=http://localhost:3000,http://localhost
