# =====================================================================
# PaperHub 配置文件（本文件为本地实际配置，已被 .gitignore 忽略，勿提交）
# 修改后需重启 backend / worker / frontend 生效。
# 所有 Secret 均通过环境变量注入，禁止写死在代码中。
# =====================================================================

# ---------------------------------------------------------------------
# 核心服务连接
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://paperhub:paperhub@localhost:5432/paperhub
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# MinIO 对象存储
# ---------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=paperhub
MINIO_SECRET_KEY=paperhub-secret
MINIO_SECURE=false
MINIO_BUCKET=paperhub

# ---------------------------------------------------------------------
# MinerU 解析（PDF -> Markdown + 图片）
#   留空则使用 MockMinerUService（PyMuPDF 本地解析，无需 Key 也能跑通）
#   填入后自动切换为远程 MinerU API
# ---------------------------------------------------------------------
MINERU_API_URL=
MINERU_API_KEY=

# ---------------------------------------------------------------------
# YOLO Figure 检测
#   留空 YOLO_MODEL_PATH 则使用启发式检测（将 MinerU 提取图片归类为 Figure）
#   把训练好的权重放到 models/ 目录，并在此填入路径
# ---------------------------------------------------------------------
YOLO_ENABLED=false
YOLO_MODEL_PATH=./models/figure.pt

# ---------------------------------------------------------------------
# LLM（OpenAI-compatible，默认 DeepSeek）
#   留空 API Key 则使用 MockLLMService；填入后调用真实模型
#   可换成 OpenAI / Gemini-compatible / 本地 Ollama（http://localhost:11434/v1）
# ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT=120

# ---------------------------------------------------------------------
# 微信公众号
#   留空则使用 MockWeChatPublisher；填入后真实发送到公众号草稿箱
# ---------------------------------------------------------------------
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------------------------------------------------------------------
# PaperHub 自身 API 鉴权
#   留空 = 开发模式不鉴权；设置后需 Authorization: Bearer xxx
#   CLI 用 `paperhub config set api-key xxx` 保存
# ---------------------------------------------------------------------
PAPERHUB_API_KEY=

# ---------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost
